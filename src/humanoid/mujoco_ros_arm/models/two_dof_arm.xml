<mujoco model="two_dof_arm">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option integrator="RK4" timestep="0.005"/>
  
  <default>
    <joint armature="0.5" damping="0.1" limited="true"/>
    <geom condim="1" rgba="0.8 0.8 0.8 1"/>
  </default>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" pos="0 0 0" size="2 2 0.1" rgba="0.9 0.9 0.9 1"/>
    
    <!-- 底座 -->
    <body name="base" pos="0 0 0.05">
      <geom name="base_geom" type="cylinder" size="0.08 0.05" mass="0.5" rgba="0.3 0.3 0.3 1"/>
      
      <!-- 大臂关节 -->
      <body name="upper_arm" pos="0 0 0.1">
        <joint name="shoulder_joint" type="hinge" axis="0 1 0" range="-1.5 1.5"/>
        <geom name="upper_arm_geom" type="capsule" fromto="0 0 0 0 0 0.2" size="0.02" mass="0.2" rgba="0.2 0.5 0.8 1"/>
        
        <!-- 小臂关节 -->
        <body name="lower_arm" pos="0 0 0.2">
          <joint name="elbow_joint" type="hinge" axis="0 1 0" range="-2.0 2.0"/>
          <geom name="lower_arm_geom" type="capsule" fromto="0 0 0 0 0 0.15" size="0.015" mass="0.1" rgba="0.8 0.4 0.2 1"/>
          <geom name="tip" type="sphere" pos="0 0 0.15" size="0.02" mass="0.05" rgba="0.8 0.2 0.2 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="shoulder_motor" joint="shoulder_joint" kp="20" ctrlrange="-1.5 1.5"/>
    <position name="elbow_motor" joint="elbow_joint" kp="20" ctrlrange="-2.0 2.0"/>
  </actuator>
</mujoco>
