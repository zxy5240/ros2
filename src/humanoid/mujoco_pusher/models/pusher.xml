<mujoco model="pusher">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.005"/>
  
  <default>
    <geom condim="2" friction="1 0.1 0.1"/>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <!-- 地面桌子 -->
    <geom name="table" type="box" pos="0 0 0.05" size="0.8 0.4 0.05" rgba="0.6 0.4 0.2 1"/>
    
    <!-- 推杆底座 -->
    <body name="base" pos="-0.6 0 0.15">
      <geom name="base_geom" type="box" size="0.1 0.1 0.1" rgba="0.3 0.3 0.3 1"/>
      
      <!-- 推杆（直线关节） -->
      <body name="rod" pos="0.1 0 0">
        <joint name="push_joint" type="slide" axis="1 0 0" range="0 0.6"/>
        <geom name="rod_geom" type="cylinder" fromto="0 0 0 0.5 0 0" size="0.02" rgba="0.8 0.2 0.2 1"/>
        <geom name="head" type="box" pos="0.5 0 0" size="0.05 0.08 0.05" rgba="0.2 0.2 0.8 1"/>
      </body>
    </body>
    
    <!-- 要推的小方块 -->
    <body name="block" pos="0.3 0 0.15">
      <geom name="block_geom" type="box" size="0.1 0.1 0.1" mass="0.5" rgba="0.2 0.8 0.2 1"/>
    </body>
  </worldbody>

  <actuator>
    <position name="push_motor" joint="push_joint" kp="100" ctrlrange="0 0.6"/>
  </actuator>
</mujoco>
